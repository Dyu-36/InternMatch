# Canonical public origin. In production, set this to the trusted site origin and allow <NEXT_PUBLIC_SITE_URL>/auth/callback in Supabase Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://johsqcfalnqdbksenyjy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Set these project-specific values on Vercel when a Supabase integration also sets NEXT_PUBLIC_SUPABASE_*.
NEXT_PUBLIC_INTERNMATCH_SUPABASE_URL=https://johsqcfalnqdbksenyjy.supabase.co
NEXT_PUBLIC_INTERNMATCH_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
AUTH_EMAIL_DOMAIN=internmatch.vercel.app
# Development-only asset search; never expose this as NEXT_PUBLIC_PEXELS_API_KEY.
PEXELS_API_KEY=
